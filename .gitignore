# Dependencies
node_modules/

# Build output
dist/
src-tauri/target/
# Tauri regenerates its schemas; the Android project is checked in.
src-tauri/gen/schemas/
# Gradle needs its wrapper jar, which global *.jar rules would otherwise hide.
!src-tauri/gen/android/gradle/wrapper/gradle-wrapper.jar

# Generated app icons (regenerate with `npm run icon`)
app-icon.png

# Editor / OS
.DS_Store
*.local
.idea/
.vscode/*
!.vscode/extensions.json

# Environment variables
.env
.env.*.local

# Vite cache
.vite/

# Logs
*.log

# Playwright
test-results/
playwright-report/
blob-report/

# The diary data file lives OUTSIDE this repo by design — never commit it.
*.ics

#agents
.claude/
.agents/
# Public site build (landing + web app) and local Wrangler state
dist-web/
.wrangler/
