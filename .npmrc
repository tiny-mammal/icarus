@martinezharo:registry=https://npm.pkg.github.com
# Read-only token for the private promo-funnel package. GitHub Actions sets it
# from the PROMO_FUNNEL_TOKEN secret; Workers Builds needs the same name as a
# build secret. Installs without it still resolve everything else.
//npm.pkg.github.com/:_authToken=${PROMO_FUNNEL_TOKEN}
